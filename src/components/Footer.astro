---
import { NAV, SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div>
      <p class="site-footer__brand">{SITE.name}</p>
      <p class="site-footer__text">
        Generador gratuito de letras y categorías para jugar a Scattergories, Stop, Basta o Tutti Frutti en español. Sin
        registro y sin instalar nada.
      </p>
    </div>
    <nav aria-label="Pie de página">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="wrap site-footer__legal">
    <p>
      © {year} {SITE.name}. Proyecto independiente. «Scattergories» es una marca registrada de su propietario; este sitio
      no está afiliado a ella.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-7);
    border-top: 2px solid var(--ink);
    background: var(--paper-2);
    padding-block: var(--space-6) var(--space-4);
    font-size: 0.95rem;
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .site-footer__brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
  }

  .site-footer__text {
    color: var(--ink-soft);
    max-width: 30rem;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }

  .site-footer a {
    color: var(--ink);
    display: inline-block;
    padding-block: 0.2rem;
  }

  .site-footer__legal {
    margin-top: var(--space-5);
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
</style>
