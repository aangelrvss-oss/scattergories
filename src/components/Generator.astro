---
import Icon from './Icon.astro';
import SettingsDialog from './SettingsDialog.astro';
import type { GeneratorMode } from '../types/game';
import { TIMER_PRESETS, DEFAULT_TIMER_SECONDS, DEFAULT_CATEGORY_COUNT } from '../utils/settings';
import { formatTime } from '../utils/timer';

interface Preset {
  /** Texto del botón, p. ej. «Columnas clásicas». */
  label: string;
  categories: readonly string[];
}

interface Props {
  mode?: GeneratorMode;
  preset?: Preset;
  /** Título accesible de la sección. */
  label?: string;
}

const { mode = 'full', preset, label = 'Generador de rondas' } = Astro.props;
const showLetter = mode !== 'categories';
const showCategories = mode !== 'letters';
const primaryLabel = mode === 'letters' ? 'Nueva letra' : mode === 'categories' ? 'Nuevas categorías' : 'Nueva ronda';
const presetData = preset ? JSON.stringify(preset) : undefined;
---

<section
  class:list={['game', `game--${mode}`]}
  id="juego"
  aria-label={label}
  data-game
  data-mode={mode}
  data-phase="empty"
  data-preset={presetData}
>
  <div class="game__bar">
    <p class="game__status">
      <span class="game__round" data-el="round-label">Preparado para jugar</span>
      <span class="game__phase" data-el="phase"></span>
      {showCategories && (
        <span class="game__pack">
          Pack <strong data-el="pack-name">Clásico</strong>
        </span>
      )}
    </p>
    <div class="game__tools">
      <button class="icon-btn" type="button" data-action="sound" aria-pressed="true" title="Sonido (activado)">
        <Icon name="soundOn" class="icon-on" />
        <Icon name="soundOff" class="icon-off" />
        <span class="sr-only">Sonido</span>
      </button>
      <button
        class="icon-btn"
        type="button"
        data-action="settings"
        aria-haspopup="dialog"
        aria-controls="ajustes"
        title="Ajustes"
      >
        <Icon name="settings" />
        <span class="sr-only">Ajustes</span>
      </button>
      <button class="btn btn--small present-btn" type="button" data-action="present" title="Modo presentación (F)">
        <Icon name="expand" class="when-normal" />
        <Icon name="shrink" class="when-present" />
        <span data-el="present-label">Presentar</span>
      </button>
    </div>
  </div>

  <div class="game__grid">
    {
      showLetter && (
        <div class="game__letter-col">
          <div class="tile" data-el="tile">
            <span class="tile__label" id="letra-label">
              Letra
            </span>
            <output class="tile__letter" data-el="letter" aria-labelledby="letra-label" aria-live="polite">
              ?
            </output>
            <span class="tile__stop" aria-hidden="true">
              ¡STOP!
            </span>
          </div>
          {mode !== 'letters' && (
            <button class="btn btn--small host-secondary" type="button" data-action="letter" title="Otra letra (L)">
              <Icon name="dice" />
              Otra letra
            </button>
          )}
          <div class="used">
            <p class="used__head">
              <span data-el="remaining">Quedan 21 letras</span>
              <button class="link-btn" type="button" data-action="reset-letters">
                Reiniciar letras
              </button>
            </p>
            <ol class="used__list" data-el="used" aria-label="Letras que ya han salido" />
          </div>
        </div>
      )
    }

    {
      showCategories && (
        <div class="game__cats-col">
          <div class="cats-head">
            <h2 class="cats-head__title" id="categorias-titulo">
              Categorías
            </h2>
            <div class="stepper" role="group" aria-label="Número de categorías">
              <button class="icon-btn" type="button" data-action="count-down" title="Una categoría menos">
                <Icon name="minus" />
                <span class="sr-only">Una categoría menos</span>
              </button>
              <output class="stepper__value" data-el="count" aria-live="polite">
                {DEFAULT_CATEGORY_COUNT}
              </output>
              <button class="icon-btn" type="button" data-action="count-up" title="Una categoría más">
                <Icon name="plus" />
                <span class="sr-only">Una categoría más</span>
              </button>
            </div>
          </div>
          <div class="cats-box" data-el="cats-box">
            <p class="cats-empty" data-el="cats-empty">
              Pulsa <strong>{primaryLabel}</strong> para sacar {mode === 'categories' ? 'una lista' : 'letra y categorías'}.
            </p>
            <ol class="cats" data-el="cats" aria-labelledby="categorias-titulo" />
          </div>
          <div class="cats-actions">
            {mode !== 'categories' && (
              <button class="btn btn--small host-secondary" type="button" data-action="categories" title="Otras categorías (C)">
                <Icon name="refresh" />
                Otras categorías
              </button>
            )}
            <button class="btn btn--small not-present" type="button" data-action="copy">
              <Icon name="copy" />
              <span data-el="copy-label">Copiar</span>
            </button>
            <button class="btn btn--small not-present" type="button" data-action="print">
              <Icon name="print" />
              Imprimir hoja
            </button>
            {preset && (
              <button class="btn btn--small not-present" type="button" data-action="preset">
                <Icon name="list" />
                {preset.label}
              </button>
            )}
          </div>
        </div>
      )
    }

    <div class="timer" data-el="timer" data-status="idle">
      <div class="timer__top">
        <span class="timer__label" id="timer-label">Tiempo</span>
        <div class="timer__face" role="timer" aria-labelledby="timer-label" data-el="time">
          {formatTime(DEFAULT_TIMER_SECONDS * 1000)}
        </div>
        <span class="timer__stop" aria-hidden="true">¡STOP!</span>
      </div>
      <div class="timer__track" aria-hidden="true"><span class="timer__fill" data-el="timer-fill"></span></div>
      <div class="timer__presets" role="group" aria-label="Duración del temporizador">
        {
          TIMER_PRESETS.map((s) => (
            <button class="chip" type="button" data-duration={s} aria-pressed={s === DEFAULT_TIMER_SECONDS ? 'true' : 'false'}>
              {formatTime(s * 1000)}
            </button>
          ))
        }
        <button class="chip" type="button" data-action="custom-time" aria-expanded="false" aria-controls="tiempo-personalizado">
          Otro
        </button>
      </div>
      <form class="custom-time" id="tiempo-personalizado" data-el="custom-time" hidden>
        <label>
          <span>Minutos</span>
          <input type="number" name="min" min="0" max="60" step="1" inputmode="numeric" value="2" />
        </label>
        <label>
          <span>Segundos</span>
          <input type="number" name="sec" min="0" max="59" step="1" inputmode="numeric" value="0" />
        </label>
        <button class="btn btn--small" type="submit">Aplicar</button>
      </form>
      <div class="timer__controls">
        <button class="btn timer__start" type="button" data-action="timer" title="Empezar o pausar (T)">
          <Icon name="play" class="when-stopped" />
          <Icon name="pause" class="when-running" />
          <span data-el="timer-action">Empezar</span>
        </button>
        <button class="btn btn--ghost" type="button" data-action="timer-reset">
          <Icon name="reset" />
          Reiniciar tiempo
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-el="timer-announcer"></p>
    </div>
  </div>

  <div class="game__actions">
    <button class="mini-timer" type="button" data-action="timer" data-el="mini-timer">
      <Icon name="play" class="when-stopped" />
      <Icon name="pause" class="when-running" />
      <span class="sr-only">Temporizador:</span>
      <span class="mini-timer__time" data-el="time-mini">{formatTime(DEFAULT_TIMER_SECONDS * 1000)}</span>
      <span class="sr-only" data-el="timer-action-mini">Empezar</span>
    </button>
    <button class="btn btn--primary game__main host-secondary" type="button" data-action="new" title={`${primaryLabel} (N)`}>
      {primaryLabel}
    </button>
  </div>

  <div class="game__footer">
    <button class="btn btn--ghost btn--small" type="button" data-action="reset-game" data-el="reset-game">
      <Icon name="reset" />
      <span data-el="reset-game-label">Nueva partida</span>
    </button>
    <p class="game__shortcuts">
      Atajos: <kbd>N</kbd> {primaryLabel.toLowerCase()}
      {mode === 'full' && <>· <kbd>L</kbd> letra · <kbd>C</kbd> categorías</>}
      · <kbd>T</kbd> tiempo · <kbd>F</kbd> presentación
    </p>
  </div>

  <div class="stop-overlay" data-el="stop-overlay" aria-hidden="true">
    <span class="stop-overlay__word">¡STOP!</span>
    <span class="stop-overlay__hint">Bolis abajo: comparad respuestas</span>
  </div>

  <p class="toast" role="status" aria-live="polite" data-el="toast"></p>

  <SettingsDialog mode={mode} />
</section>

<script>
  import { initGame } from '../scripts/game-ui';

  const root = document.querySelector<HTMLElement>('[data-game]');
  if (root) initGame(root);
</script>

<style is:global>
  .game {
    position: relative;
    border: 2px solid var(--ink);
    border-radius: var(--radius-l);
    background: var(--card);
    box-shadow: 6px 6px 0 var(--ink);
    padding: var(--space-3) var(--space-4) var(--space-4);
    margin-block: var(--space-4) var(--space-6);
  }

  @media (min-width: 48rem) {
    .game {
      padding: var(--space-4) var(--space-5) var(--space-5);
    }
  }

  .game__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-4);
    border-bottom: 2px dashed var(--line-strong);
  }

  .game__status {
    flex: 1 1 12rem;
    min-width: 0;
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.3;
  }

  .game__status strong {
    color: var(--ink);
  }

  .game__round {
    font-weight: 700;
    color: var(--ink);
  }

  .game__phase:empty {
    display: none;
  }

  .game__phase::before,
  .game__pack::before {
    content: '·';
    margin-inline: 0.35rem;
    color: var(--ink-soft);
  }

  .game[data-phase='playing'] .game__phase {
    color: var(--ok);
    font-weight: 700;
  }

  .game[data-phase='stop'] .game__phase {
    color: var(--accent);
    font-weight: 800;
  }

  .game__tools {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex: none;
    margin-left: auto;
  }

  .present-btn {
    min-height: 2.5rem;
    margin-left: var(--space-1);
  }

  .game .when-present,
  .game.is-present .when-normal {
    display: none;
  }

  .game.is-present .when-present {
    display: block;
  }

  .game__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'letter' 'cats' 'timer';
  }

  .game--letters .game__grid {
    grid-template-areas: 'letter' 'timer';
  }

  .game--categories .game__grid {
    grid-template-areas: 'cats' 'timer';
  }

  .game__letter-col {
    grid-area: letter;
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    align-content: start;
  }

  .game__cats-col {
    grid-area: cats;
    min-width: 0;
  }

  /* En móvil, la ficha va a la izquierda y sus controles a la derecha
     para que las categorías queden a la vista sin hacer scroll. */
  @media (max-width: 45.99rem) {
    .game--full .game__letter-col {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: 'tile button' 'tile used';
      justify-items: start;
      align-items: center;
      column-gap: var(--space-4);
      row-gap: var(--space-2);
    }

    .game--full .tile {
      grid-area: tile;
      width: clamp(7.5rem, 38vw, 10rem);
    }

    .game--full .tile__letter {
      font-size: clamp(5rem, 26vw, 7rem);
    }

    .game--full .tile__label {
      top: 0.45rem;
      left: 0.6rem;
      font-size: 0.7rem;
    }

    .game--full .tile__stop {
      font-size: 0.9rem;
      bottom: 0.5rem;
    }

    .game--full .game__letter-col > .btn {
      grid-area: button;
      align-self: end;
      white-space: nowrap;
    }

    .cats__tools .icon-btn {
      width: 2.25rem;
    }

    .game--full .used {
      grid-area: used;
      align-self: start;
      text-align: left;
    }

    .game--full .used__head,
    .game--full .used__list {
      justify-content: flex-start;
    }
  }

  .timer {
    grid-area: timer;
  }

  @media (min-width: 46rem) {
    .game--full .game__grid {
      grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.4fr);
      grid-template-areas: 'letter cats' 'timer cats';
      align-items: start;
    }

    .game--letters .game__grid {
      grid-template-columns: 1.2fr 1fr;
      grid-template-areas: 'letter timer';
      align-items: center;
    }

    .game--categories .game__grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(15rem, 0.8fr);
      grid-template-areas: 'cats timer';
      align-items: start;
    }
  }

  /* ---------- Ficha de la letra ---------- */

  .tile {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 15rem);
    aspect-ratio: 1;
    border: 3px solid var(--ink);
    border-radius: var(--radius-l);
    background: var(--paper);
    box-shadow: 8px 8px 0 var(--accent), 8px 8px 0 2px var(--ink);
    overflow: hidden;
  }

  .game--letters .tile {
    width: min(100%, 20rem);
  }

  .tile__label {
    position: absolute;
    top: 0.7rem;
    left: 0.9rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .tile__letter {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(7rem, 34vw, 10.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
    transform-origin: 50% 60%;
  }

  .game--letters .tile__letter {
    font-size: clamp(8rem, 42vw, 14rem);
  }

  .tile.is-empty .tile__letter {
    color: var(--line-strong);
  }

  .tile.is-new .tile__letter {
    animation: tile-pop 0.38s cubic-bezier(0.2, 0.9, 0.3, 1.3);
  }

  @keyframes tile-pop {
    0% {
      transform: scale(0.55) rotate(-8deg);
      opacity: 0;
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }

  .tile__stop {
    position: absolute;
    bottom: 0.8rem;
    left: 50%;
    transform: translateX(-50%) rotate(-4deg);
    padding: 0.15rem 0.7rem;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    display: none;
  }

  .game[data-phase='stop'] .tile__stop {
    display: block;
  }

  /* ---------- Letras usadas ---------- */

  .used {
    width: 100%;
    max-width: 22rem;
    text-align: center;
  }

  .used__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2rem var(--space-3);
    margin: 0 0 var(--space-2);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .link-btn {
    padding: 0.2rem 0.1rem;
    border: 0;
    background: none;
    color: var(--accent);
    font-weight: 650;
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
    min-height: 1.75rem;
  }

  .used__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem;
    padding: 0;
    margin: 0;
    list-style: none;
    min-height: 1.9rem;
  }

  .used__list li {
    display: grid;
    place-items: center;
    min-width: 1.9rem;
    height: 1.9rem;
    padding-inline: 0.3rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 6px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink-soft);
    background: var(--paper);
  }

  .used__list li[aria-current='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  /* ---------- Categorías ---------- */

  .cats-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .cats-head__title {
    margin: 0;
    font-size: 1.4rem;
  }

  .stepper {
    display: inline-flex;
    align-items: center;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
  }

  .stepper .icon-btn {
    width: 2.5rem;
    height: 2.5rem;
  }

  .stepper__value {
    min-width: 2ch;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
  }

  .cats-box {
    min-height: 12rem;
  }

  .cats-empty {
    margin: var(--space-4) 0;
    padding: var(--space-5) var(--space-4);
    border: 2px dashed var(--line-strong);
    border-radius: var(--radius);
    text-align: center;
    color: var(--ink-soft);
  }

  .cats {
    counter-reset: cat;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--space-5);
  }

  @media (min-width: 34rem) {
    .game--categories .cats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .game--full .cats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .cats li {
    counter-increment: cat;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.9rem;
    border-bottom: 1.5px solid var(--line);
    padding-block: 0.15rem;
  }

  .cats li::before {
    content: counter(cat);
    flex: none;
    width: 1.75rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .cats__name {
    flex: 1;
    min-width: 0;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .cats__tools {
    display: flex;
    flex: none;
    opacity: 0.75;
  }

  .cats li:hover .cats__tools,
  .cats li:focus-within .cats__tools {
    opacity: 1;
  }

  .cats__tools .icon-btn {
    width: 2.5rem;
    height: 2.5rem;
  }

  .cats__tools .icon-btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .cats.is-new li {
    animation: cat-in 0.3s ease both;
  }

  @keyframes cat-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  .cats-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  /* ---------- Temporizador ---------- */

  .timer {
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4) var(--space-4);
    background: var(--paper);
  }

  .timer__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .timer__label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .timer__face {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 11vw, 3.4rem);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .timer[data-status='finished'] .timer__face,
  .timer.is-low .timer__face {
    color: var(--accent);
  }

  .game[data-phase='stop'] .timer {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent);
    animation: timeup 0.6s ease 3;
  }

  @keyframes timeup {
    50% {
      box-shadow: 0 0 0 8px var(--accent-soft);
    }
  }

  .timer__track {
    height: 6px;
    margin-block: var(--space-2) var(--space-3);
    border-radius: 999px;
    background: var(--line);
    overflow: hidden;
  }

  .timer__fill {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--accent);
    transform-origin: left center;
    transition: transform 0.2s linear;
  }

  .timer__presets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .chip {
    min-height: 2.5rem;
    min-width: 3.25rem;
    padding: 0.25rem 0.75rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    background: var(--card);
    font-weight: 650;
    font-size: 0.95rem;
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    touch-action: manipulation;
  }

  .chip:hover {
    border-color: var(--ink);
  }

  .chip[aria-pressed='true'],
  .chip[aria-expanded='true'],
  .chip[data-active] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .custom-time {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .custom-time[hidden] {
    display: none;
  }

  .custom-time label {
    display: grid;
